@using Microsoft.Extensions.Options
@using Humanizer
@inject IOptions<AppSettings> AppSettings
@model Dangl.WebDocumentation.ViewModels.Admin.IndexViewModel

<h1>Admin Section</h1>

<h3>Projects</h3>
<p>Storage totals include HTML packages, Markdown packages and assets across all versions. Unavailable package sizes are excluded and marked below.</p>
<p>
    <a asp-action="CreateProject">Create a new project</a>
</p>
@{
    if (!Model.Projects.Any())
    {
        <h3>No projects configured</h3>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Project</th>
                    <th>HTML packages</th>
                    <th>Markdown packages</th>
                    <th>Assets</th>
                    <th>Total storage</th>
                    <th colspan="3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var project in Model.Projects)
                    {
                        <tr>
                            <td>@project.Name</td>
                            <td>@project.PackageSizeInBytes.Bytes().Humanize("##0.00")</td>
                            <td>@project.MarkdownPackageSizeInBytes.Bytes().Humanize("##0.00")</td>
                            <td>@project.AssetSizeInBytes.Bytes().Humanize("##0.00")</td>
                            <td title="@project.TotalSizeInBytes bytes">
                                @if (project.PackagesWithoutSize > 0)
                                {
                                    <span>At least </span>
                                }
                                @project.TotalSizeInBytes.Bytes().Humanize("##0.00")
                                @if (project.PackagesWithoutSize > 0)
                                {
                                    <small>(@project.PackagesWithoutSize package size(s) unavailable)</small>
                                }
                            </td>
                            <td><a asp-action="EditProject" asp-route-projectId="@project.Id">Edit</a></td>
                            <td><a asp-action="DeleteProject" asp-route-projectId="@project.Id">Delete</a></td>
                            <td><a asp-action="UploadProject" asp-route-projectId="@project.Id">Upload Package</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
}

<h3>Users</h3>
<a asp-action="ManageUsers">Manage users</a>
<h3>MCP Client Configurations</h3>
<p>Publish connection instructions and client settings for users.</p>
<a asp-action="McpClientConfigurations">Manage MCP client configurations</a>
<h3>Hangfire Dashboard</h3>
<p>The read-only MonthlyStorageAudit job checks for unreferenced files on the first day of each month (UTC).
    Its result lists dangling files and their total size; findings are also logged as warnings.
    Files modified within the last 24 hours are skipped to avoid reporting uploads in progress.
    No files are automatically deleted. You can also trigger the job from the dashboard.</p>
<p>
    <a href="@AppConstants.HANGFIRE_DASHBOARD_LINK">Go to Dashboard</a>
</p>
<h3>Send Test Email</h3>
<p>
    By clicking this button, a test email is sent to your account to verify this service can send emails.
</p>
<form asp-controller="Admin" asp-action="SendTestEmail" method="post">
    <button class="btn btn-raised btn-primary">Send Test Email</button>
</form>
